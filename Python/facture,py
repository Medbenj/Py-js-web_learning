Prix_unitaire = int(input("entrer le prix unitaire : "))
quantite = int(input("entrer la quantite : "))
TVA = int(input("entrer le taux de TVA : "))
TTC = Prix_unitaire*quantite*(1 + TVA/100)
print("===========FACTURE============")
print(f"Prix Unitaire = {Prix_unitaire}$")
print(f"Quantite = {quantite}")
print(f"Taux de TVA = {TVA}%")
print(f"Total TTC = {TTC}$")
print("==============================")